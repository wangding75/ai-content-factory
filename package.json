{
  "name": "ai-content-factory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run && pnpm -r test",
    "build": "pnpm -r build",
    "db:check": "pnpm --filter @ai-content-factory/api-server db:check",
    "ci:check": "bash scripts/ci.sh"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "1.6.1",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "pnpm": {
    "overrides": {
      "test-exclude@6.0.0>glob": "7.2.3",
      "glob": "13.0.6",
      "lodash": "4.18.1",
      "multer": "2.1.1",
      "picomatch": "4.0.4"
    },
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "nestjs-pino",
      "prisma"
    ]
  }
}
