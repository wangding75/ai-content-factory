{
  "name": "@ai-content-factory/api-server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "nest start --watch",
    "start": "node dist/main",
    "build": "nest build",
    "lint": "eslint --no-eslintrc --env node,es2022 --parser @typescript-eslint/parser --plugin @typescript-eslint --rule 'no-unused-vars: off' --rule '@typescript-eslint/no-unused-vars: error' --rule 'no-debugger: error' --ext .ts src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:check": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@prisma/client": "^5.0.0",
    "joi": "^17.0.0",
    "nestjs-pino": "^3.5.0",
    "pino": "^8.0.0",
    "pino-http": "^8.0.0",
    "reflect-metadata": "^0.1.0",
    "rxjs": "^7.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "@swc/core": "^1.3.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "prisma": "^5.0.0",
    "supertest": "^6.0.0",
    "typescript": "^5.0.0",
    "unplugin-swc": "^1.3.0",
    "vitest": "^1.0.0"
  }
}
